# Backend URL — must match where uvicorn runs
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# NGROK tunnel flag — set to "true" behind ngrok to skip browser warnings
NEXT_PUBLIC_NGROK_ENABLED=false

# Google OAuth client ID (required if Google sign-in is enabled)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Where the in-app "Documentation" links point. The default assumes your own
# deployment serves the docs at /docs/, which is what the self-host guide sets
# up. Point it elsewhere if you would rather not build the site yourself.
NEXT_PUBLIC_DOCS_URL=/docs/
