# systemd USER unit for the Ollama runtime the daemon executes against.
# Uses the user-local binary installed by scripts/install.sh when present
# (PATH puts the install directory's bin/ first), else a system-wide ollama.
#
# install.sh rewrites the paths below when installing under an INSTANCE, so
# do not assume this file is what ends up in ~/.config/systemd/user/.
[Unit]
Description=Ollama inference runtime (user)
After=network-online.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'exec "$(command -v ollama)" serve'
Environment=PATH=%h/.gpu-daemon/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
