# systemd USER unit — install to ~/.config/systemd/user/ and manage with
# `systemctl --user`. Rootless by design: everything under ~/.gpu-daemon.
# %h expands to the user's home directory.
#
# These paths must match what scripts/install.sh creates — the virtual
# environment at ~/.gpu-daemon/venv and the config beside it — not a
# development checkout. A unit pointing somewhere else enables cleanly and
# then crash-loops every 10s.
#
# `gpu-daemon` is the console script the daemon wheel installs, so the daemon
# runs from the environment that owns its dependencies and needs no working
# directory of its own.
[Unit]
Description=Sheshnag GPU Worker Daemon
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.gpu-daemon/venv/bin/gpu-daemon --config %h/.gpu-daemon/config.yaml
Environment=PATH=%h/.gpu-daemon/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10
EnvironmentFile=-%h/.gpu-daemon/.env

[Install]
WantedBy=default.target
