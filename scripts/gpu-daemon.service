# systemd USER unit — install to ~/.config/systemd/user/ and manage with
# `systemctl --user`. Rootless by design: everything under ~/.gpu-daemon.
# %h expands to the user's home directory.
[Unit]
Description=Sheshnag GPU Worker Daemon
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workplace/gamekeepers/repos/sheshnag/daemon
ExecStart=%h/workplace/gamekeepers/repos/sheshnag/.venv/bin/python -m daemon.main --config %h/workplace/gamekeepers/repos/sheshnag/daemon/config.yaml
Environment=PATH=%h/workplace/gamekeepers/repos/sheshnag/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10
EnvironmentFile=-%h/workplace/gamekeepers/repos/sheshnag/daemon/.env

[Install]
WantedBy=default.target
