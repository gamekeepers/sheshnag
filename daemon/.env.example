# Daemon environment. Copy to daemon/.env; the systemd unit reads it via
# EnvironmentFile, and scripts/install.sh leaves it for you to add.
#
# Every DAEMON_* setting can also live in config.yaml. Precedence is
# CLI > environment > YAML > defaults.

# ── Control plane ──
# DAEMON_BACKEND_URL=https://sheshnag.example.edu
# DAEMON_API_KEY=gk-...

# ── Runtime ──
# DAEMON_RUNTIME=ollama
# DAEMON_OLLAMA_URL=http://localhost:11434
# DAEMON_LLAMACPP_URL=http://localhost:8080

# ── Reaching the control plane through a proxy ──
# For a worker on a network with no outbound route. The first of these that is
# set is used; `socks5h://` resolves the hostname at the proxy, so TLS
# verification behaves as it would on a direct connection.
#
# ALL_PROXY=socks5h://127.0.0.1:1080
# HTTPS_PROXY=http://proxy.example.edu:3128
#
# Keep the runtime local — it listens on this machine, not through the proxy.
# NO_PROXY=127.0.0.1,localhost

# ── Tuning ──
# DAEMON_MAX_CONCURRENT_PROMPTS=8
# DAEMON_INFERENCE_TIMEOUT=300.0
# DAEMON_LOG_LEVEL=INFO
