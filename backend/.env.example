# JWT signing key (required — change from default in production)
SECRET_KEY=batch-ai-platform-secret-change-in-production

# Database connection string (required)
DATABASE_URL=sqlite:///./jobs.db

# Google OAuth client ID (required for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend URL for email links and redirects (required for password reset / invites)
FRONTEND_URL=http://localhost:3000

# Mailgun settings (optional — email sending skipped gracefully if unset)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Sheshnag support <noreply@sheshnag.io>
