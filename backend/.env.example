# JWT signing key — REQUIRED; the backend refuses to start without it.
# Set a distinct random value in every environment.
# Generate one with: openssl rand -hex 32
SECRET_KEY=

# Database connection string (required for production; SQLite fine for dev)
DATABASE_URL=sqlite:///./jobs.db

# Google OAuth client ID (required for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend URL for email links and redirects (required for password reset / invites)
FRONTEND_URL=http://localhost:3000

# CORS origins — comma-separated list of concrete origins. "*" is not
# accepted (credentials are allowed) and falls back to localhost only.
# Production: set the deployed frontend, e.g. https://sheshnag.dau.ac.in
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mailgun settings (optional — email sending skipped gracefully if unset)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Sheshnag support <noreply@sheshnag.io>
