# JWT signing key — set a distinct random value in every environment.
# If left unset the app falls back to a built-in key that is public (it is in
# git history), logs a WARNING at startup, and signs forgeable tokens.
# Generate one with: openssl rand -hex 32
# SECRET_KEY=

# Database connection string (required for production; SQLite fine for dev)
DATABASE_URL=sqlite:///./jobs.db

# Google OAuth client ID (required for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend URL for email links and redirects (required for password reset / invites)
FRONTEND_URL=http://localhost:3005

# CORS origins — comma-separated list or "*" for all.
# When credentials are used (cookies, auth headers), set concrete origins
# instead of "*". Default allows everything for local dev.
CORS_ORIGINS=*

# Mailgun settings (optional — email sending skipped gracefully if unset)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Sheshnag support <noreply@sheshnag.io>
